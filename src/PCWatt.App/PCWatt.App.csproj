<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/PCWatt.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../PCWatt.Core/PCWatt.Core.csproj" />
    <ProjectReference Include="../PCWatt.Infrastructure/PCWatt.Infrastructure.csproj" />
    <ProjectReference Include="../PCWatt.Launcher/PCWatt.Launcher.csproj" ReferenceOutputAssembly="false" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Launch.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/Motion/*.svg" />
    <Content Include="Assets/Motion/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeAutostartLauncher" AfterTargets="Build">
    <MSBuild Projects="../PCWatt.Launcher/PCWatt.Launcher.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="LauncherTarget" />
    </MSBuild>
    <PropertyGroup><LauncherTargetDirectory>@(LauncherTarget->'%(RootDir)%(Directory)')</LauncherTargetDirectory></PropertyGroup>
    <ItemGroup><LauncherFiles Include="$(LauncherTargetDirectory)PCWatt.Launcher.*" Exclude="$(LauncherTargetDirectory)*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(LauncherFiles)" DestinationFolder="$(OutDir)launcher" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishAutostartLauncher" AfterTargets="Publish">
    <ItemGroup><PublishLauncherFiles Include="$(OutDir)launcher/PCWatt.Launcher.*" /></ItemGroup>
    <Copy SourceFiles="@(PublishLauncherFiles)" DestinationFolder="$(PublishDir)launcher" SkipUnchangedFiles="true" />
  </Target>
</Project>
