<Window x:Class="PCWatt.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PCWatt.App.Controls" Title="{Binding WindowTitle}" Width="1440" Height="980" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{StaticResource WindowBg}" FontFamily="{StaticResource UiFont}" FontSize="13" Language="zh-CN" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource Surface}">
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource StrokeSoft}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}">
                            <Path Data="M13,2 L5,14 L10,14 L8,22 L19,9 L13,9 Z" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PCWatt" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                        <Border Width="1" Height="15" Background="{StaticResource Stroke}" Margin="14,0,13,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Ink3}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Click="MinimizeClick" ToolTip="最小化" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource GlyphFont}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="ToggleMaximizeClick" ToolTip="最大化" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource GlyphFont}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Click="CloseClick" ToolTip="关闭" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource GlyphFont}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 侧栏 + 内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="10,18,10,0">
                            <Button Style="{StaticResource Navigation}" Tag="{Binding IsOverview}" Command="{Binding ShowOverviewCommand}" ToolTip="能耗概览">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource GlyphFont}" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    <TextBlock Text="概览" Margin="12,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Navigation}" Tag="{Binding IsSettings}" Command="{Binding ShowSettingsCommand}" ToolTip="偏好设置">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource GlyphFont}" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    <TextBlock Text="设置" Margin="12,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="20,0,20,20">
                            <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Warn}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSampling}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="仅保存在本机" Foreground="{StaticResource Ink3}" FontSize="10.5" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource WindowBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="34,24,34,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 页头 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" FontSize="12" Margin="1,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSampling}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Ink2}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Width="1" Height="22" Background="{StaticResource StrokeSoft}" Margin="0,0,18,0" />
                                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DateLabel}" FontSize="11.5" Foreground="{StaticResource Ink3}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{StaticResource Ink2}" HorizontalAlignment="Right" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <Button Command="{Binding ToggleSamplingCommand}" Content="{Binding SamplingButtonText}" Style="{StaticResource PrimaryButton}" Padding="16,9" AutomationProperties.AutomationId="ToggleSampling" />
                            </StackPanel>
                        </Grid>

                        <!-- 概览 -->
                        <Grid Grid.Row="1" Visibility="{Binding IsOverview, Converter={StaticResource VisibleWhenTrue}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Visibility="{Binding HasHardwareChannels, Converter={StaticResource VisibleWhenTrue}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="CategorySelector" ItemsSource="{Binding PowerCategories}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource PowerCategoryChoice}" Content="{Binding Name}" GroupName="PowerCategory" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Column="1" x:Name="DeviceSelector" ItemsSource="{Binding DeviceOptions}" Margin="18,0" VerticalAlignment="Center" Visibility="{Binding HasDeviceChoices, Converter={StaticResource VisibleWhenTrue}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource DeviceChoice}" Content="{Binding Name}" GroupName="PowerDevice" IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Description}"
                                                Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource PeriodChoice}" Content="小时" GroupName="BillingPeriod" IsChecked="{Binding IsHourPeriod, Mode=OneWay}" Command="{Binding ShowHourBillingCommand}" AutomationProperties.Name="小时电费" />
                                    <RadioButton Style="{StaticResource PeriodChoice}" Content="今日" GroupName="BillingPeriod" IsChecked="{Binding IsDayPeriod, Mode=OneWay}" Command="{Binding ShowDayBillingCommand}" AutomationProperties.Name="今日电费" />
                                    <RadioButton Style="{StaticResource PeriodChoice}" Content="周" GroupName="BillingPeriod" IsChecked="{Binding IsWeekPeriod, Mode=OneWay}" Command="{Binding ShowWeekBillingCommand}" AutomationProperties.Name="七天电费" />
                                    <RadioButton Style="{StaticResource PeriodChoice}" Content="本月" GroupName="BillingPeriod" IsChecked="{Binding IsMonthPeriod, Mode=OneWay}" Command="{Binding ShowMonthBillingCommand}" AutomationProperties.Name="本月电费" />
                                    <RadioButton Style="{StaticResource PeriodChoice}" Content="今年" GroupName="BillingPeriod" IsChecked="{Binding IsYearPeriod, Mode=OneWay}" Command="{Binding ShowYearBillingCommand}" AutomationProperties.Name="今年电费" />
                                </StackPanel>
                            </Grid>

                            <!-- 电费与实时功率 -->
                            <Grid Grid.Row="1" Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.22*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,38,0" ToolTip="{Binding BillingScope}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding BillingHeading}" FontSize="18" FontWeight="SemiBold" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent">
                                            <TextBlock Text="{Binding BillingBadge}" Foreground="{StaticResource Accent}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
                                        <TextBlock Text="¥" FontFamily="{StaticResource NumberFont}" FontSize="38" FontWeight="Light" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,10,6,0" />
                                        <TextBlock x:Name="BillingCostValue" Text="{Binding BillingCost}" Style="{StaticResource HeroMetric}" FontSize="58" Foreground="{StaticResource AccentValue}" AutomationProperties.AutomationId="BillingCost" />
                                        <controls:SvgMotion x:Name="MoneyMotion" Asset="money" Playing="{Binding DecorativeMotionEnabled}" Width="1" Height="1" Visibility="Collapsed" AutomationProperties.Name="电费装饰图标" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="1,0,0,0">
                                        <TextBlock Text="{Binding BillingEnergy}" FontSize="14" Foreground="{StaticResource Ink2}" />
                                        <Border Width="1" Height="16" Background="{StaticResource Stroke}" Margin="14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BillingCoverage}" FontSize="13" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Grid.Row="3" Margin="1,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding BillingHint}" FontSize="11.5" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Style="{StaticResource CoverageBar}" Value="{Binding BillingCoveragePercent, Mode=OneWay}" Foreground="{StaticResource Accent}" Width="110" Margin="16,0,0,0" AutomationProperties.Name="所选区间整机电量覆盖率" />
                                    </Grid>
                                </Grid>

                                <Border Grid.Column="1" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1,0,0,0" Padding="38,0,0,0" ToolTip="切换部件只影响功率与曲线，电费始终按整机统计">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding PowerHeading}" FontSize="18" FontWeight="SemiBold" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompactDataBadge}" Foreground="{StaticResource Ink3}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
                                            <controls:AnimatedPower Value="{Binding PowerWatts}" MotionEnabled="{Binding RenderMotionEnabled}" Style="{StaticResource HeroMetric}" FontSize="56" AutomationProperties.AutomationId="CurrentPower" />
                                            <TextBlock Text="W" FontFamily="{StaticResource NumberFont}" FontSize="22" FontWeight="Light" Foreground="{StaticResource Ink2}" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                                            <controls:SvgMotion x:Name="HardwareMotion" Asset="{Binding SelectedCategoryKey}" Playing="{Binding DecorativeMotionEnabled}" Width="1" Height="1" Visibility="Collapsed" AutomationProperties.Name="硬件装饰图标" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{Binding CompactPowerHint}" FontSize="11.5" Foreground="{StaticResource Ink3}" Margin="1,1,0,0" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="3" Margin="1,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="近 10 分钟平均" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                                <TextBlock Text="{Binding AveragePowerLabel}" FontFamily="{StaticResource NumberFont}" FontSize="13" Foreground="{StaticResource Ink2}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="峰值" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                                <TextBlock Text="{Binding PeakPowerLabel}" FontFamily="{StaticResource NumberFont}" FontSize="13" Foreground="{StaticResource Ink2}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 趋势 -->
                            <Border Grid.Row="2" Style="{StaticResource ChartSurface}" Padding="24,12,24,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ChartHeading}" Style="{StaticResource H2}" />
                                            <TextBlock Text="{Binding SelectedHardwareName}" FontSize="11.5" Foreground="{StaticResource Ink3}" Margin="0,5,0,0" MaxWidth="420" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedChannelDetail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="ChartRangeLabel" Text="{Binding ChartRangeLabel}" FontSize="11" Foreground="{StaticResource Ink3}" HorizontalAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0" ToolTip="{Binding ChartDescription}">
                                                <TextBlock Text="{Binding ChartMetricCaption}" FontSize="10.5" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChartMetricValue}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{StaticResource Ink2}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChartSecondCaption}" FontSize="10.5" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChartSecondValue}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{StaticResource Ink2}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0" Visibility="{Binding IsHistoryMode, Converter={StaticResource VisibleWhenTrue}}">
                                                <Button Content="‹" Command="{Binding PreviousHistoryCommand}" Style="{StaticResource QuietIconButton}" ToolTip="上一时段" AutomationProperties.Name="上一时段" />
                                                <DatePicker Width="136" Height="28" MinHeight="28" FontSize="10.5" Margin="4,0" SelectedDate="{Binding HistoryDate, Mode=TwoWay}" DisplayDateStart="2000-01-01" DisplayDateEnd="{Binding LatestHistoryDate, Mode=OneWay}" SelectedDateFormat="Short" ToolTip="选择历史日期；周视图以此日为最后一天" AutomationProperties.Name="历史日期" />
                                                <ComboBox Width="112" Height="28" Padding="7,2" Margin="0,0,4,0" ItemsSource="{Binding HistoryHours}" SelectedIndex="{Binding HistoryHour}" Visibility="{Binding IsHourPeriod, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="历史小时" />
                                                <Button Content="›" Command="{Binding NextHistoryCommand}" IsEnabled="{Binding CanNextHistory}" Style="{StaticResource QuietIconButton}" ToolTip="下一时段" AutomationProperties.Name="下一时段" />
                                                <Button Content="现在" Command="{Binding CurrentHistoryCommand}" Margin="4,0,0,0" Padding="9,3" FontSize="10" />
                                                <ToggleButton x:Name="SensorToggle" Content="硬件状态" IsChecked="{Binding IsSensorsOpen}" Margin="6,0,0,0" Padding="9,3" FontSize="10">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Face" Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeHi}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentSoft}" />
                                                                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <Popup x:Name="SensorPopup" IsOpen="{Binding IsSensorsOpen}" PlacementTarget="{Binding ElementName=SensorToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeHi}" BorderThickness="1" CornerRadius="12" Padding="18" Width="440" Margin="0,7,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="硬件状态" Style="{StaticResource H2}" />
                                                            <Grid x:Name="UtilizationPanel" Margin="0,14,0,12" ToolTip="{Binding UtilizationDetails}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <StackPanel Margin="0,0,14,12">
                                                                    <Grid>
                                                                        <TextBlock Text="CPU 占用" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                                                        <TextBlock x:Name="CpuUtilizationValue" Text="{Binding CpuUtilization}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding CpuUtilizationValue, Mode=OneWay}" Margin="0,6,0,4" AutomationProperties.Name="CPU 占用率" />
                                                                    <TextBlock x:Name="CpuTemperatureValue" Text="{Binding CpuTemperature}" FontSize="10" Foreground="{StaticResource Ink3}" ToolTip="{Binding CpuTemperatureDetail}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                                                    <Grid>
                                                                        <TextBlock Text="显卡占用" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                                                        <TextBlock x:Name="GpuUtilizationValue" Text="{Binding GpuUtilization}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding GpuUtilizationValue, Mode=OneWay}" Margin="0,6,0,4" AutomationProperties.Name="显卡核心占用率" />
                                                                    <TextBlock Text="{Binding GpuTemperature}" FontSize="10" Foreground="{StaticResource Ink3}" ToolTip="{Binding GpuTemperatureDetail}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Margin="0,0,14,0">
                                                                    <Grid>
                                                                        <TextBlock Text="内存占用" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                                                        <TextBlock x:Name="MemoryUtilizationValue" Text="{Binding MemoryUtilization}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding MemoryUtilizationValue, Mode=OneWay}" Margin="0,6,0,0" AutomationProperties.Name="物理内存占用率" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Grid.Column="1" ToolTip="{Binding DisplayDetail}">
                                                                    <Grid>
                                                                        <TextBlock Text="显示器" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                                                        <TextBlock x:Name="DisplayStateValue" Text="{Binding DisplayStateText}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding DisplayPowerHint}" FontSize="9.5" Foreground="{StaticResource Ink3}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,0,0,10" />
                                                            <TextBlock Text="{Binding SensorStatus}" FontSize="10.5" Foreground="{StaticResource Ink3}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                            <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding SensorRows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,8" ToolTip="{Binding Detail}">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="100" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Margin="0,0,8,0">
                                                                                        <TextBlock Text="{Binding Hardware}" FontSize="10" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,3,0,0" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource Accent}" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <controls:PowerTrend Grid.Row="1" x:Name="Trend" Samples="{Binding TrendSamples}" Series="{Binding ChartSeries}" History="{Binding HistoryData}" IsHistoryMode="{Binding IsHistoryMode}" HistoryColor="{Binding ChartColor}" TimeZone="{Binding ChartTimeZone}" MotionEnabled="{Binding RenderMotionEnabled}" IsRecording="{Binding IsSampling}" MinHeight="141" Margin="0,2,0,0" AutomationProperties.Name="{Binding HistoryAccessibilityName}" />

                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ChartFooter}" FontSize="10.5" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="数据覆盖" FontSize="10.5" Foreground="{StaticResource Ink3}" />
                                            <TextBlock Text="{Binding ChartCoverageText}" Foreground="{StaticResource Ink2}" FontSize="10.5" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="9" Padding="15,9" Margin="0,12,0,0" Visibility="{Binding ShowHardwareHelp, Converter={StaticResource VisibleWhenTrue}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="查看原因  ›" Command="{Binding ShowSettingsCommand}" Padding="11,5" Margin="14,0,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource WarnBorder}" Foreground="{StaticResource Warn}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource GlyphFont}" FontSize="15" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding HardwareHelpMessage}" Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11.5" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- 设置 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSettings, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel DataContext="{Binding Settings}">
                                <TextBlock Text="硬件检测" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="CPU 功率" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuHardwareStatus}" TextWrapping="Wrap" ToolTip="{Binding HardwareAccessStatus}" />
                                            <TextBlock Grid.Row="1" Text="显卡功率" Style="{StaticResource Caption}" Margin="0,8,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuHardwareStatus}" TextWrapping="Wrap" Margin="0,8,0,0" ToolTip="{Binding HardwareStatus.Gpu.Detail}" />
                                            <TextBlock Grid.Row="2" Text="整机记录" Style="{StaticResource Caption}" Margin="0,8,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WholePcHardwareStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding HardwareAccessStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        <TextBlock Text="{Binding WholePcHardwareDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="重新检测" Command="{Binding RecheckHardwareCommand}" Padding="12,6" Margin="0,0,8,8" />
                                            <Button Content="复制诊断信息" Command="{Binding CopyHardwareDiagnosticsCommand}" Padding="12,6" Margin="0,0,8,8" />
                                            <Button Content="以管理员身份重新启动" Command="{Binding EnableCpuReadCommand}" Padding="12,6" Margin="0,0,8,8" Visibility="{Binding CanRequestAdministrator, Converter={StaticResource VisibleWhenTrue}}" />
                                            <Button Content="PawnIO 官方安装说明" Command="{Binding OpenDriverPageCommand}" Padding="12,6" Margin="0,0,8,8" Visibility="{Binding CanOpenDriverPage, Converter={StaticResource VisibleWhenTrue}}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding HardwareFeedback}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="启动与后台" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Margin="0,0,70,0">
                                                <TextBlock Text="登录 Windows 后自动启动" FontSize="12.5" />
                                                <TextBlock Text="登录后自动记录；完整硬件模式会请求 Windows 授权" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding AutoStartEnabled, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="autostart" AutomationProperties.Name="开机自启动" />
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,13" />
                                        <Grid>
                                            <StackPanel Margin="0,0,70,0">
                                                <TextBlock Text="启动时读取完整硬件（推荐）" FontSize="12.5" />
                                                <TextBlock Text="默认请求管理员授权，便于读取 CPU；取消后继续记录其他硬件" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding RequestAdministratorOnLaunch, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="administrator" AutomationProperties.Name="启动时读取完整硬件" />
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,13" />
                                        <Grid>
                                            <StackPanel Margin="0,0,70,0">
                                                <TextBlock Text="关闭主窗口后留在托盘" FontSize="12.5" />
                                                <TextBlock Text="继续后台记录，可从托盘菜单完全退出" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CloseToTray, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="tray" AutomationProperties.Name="关闭后进入托盘" />
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,13" />
                                        <Grid>
                                            <StackPanel Margin="0,0,70,0">
                                                <TextBlock Text="界面动效" FontSize="12.5" />
                                                <TextBlock Text="数值过渡与曲线呼吸光点，窗口隐藏时自动停止" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MotionEnabled, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="motion" AutomationProperties.Name="界面动效" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="记录频率" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="后台记录模式" FontSize="12.5" />
                                        <TextBlock Text="默认一般（30 秒）。省电模式减少读取次数，可能漏掉短时峰值；切换图形不影响记录。" Style="{StaticResource Caption}" Margin="0,5,0,13" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource IntervalChoice}" GroupName="Interval" IsChecked="{Binding IsFive, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="5"><StackPanel><TextBlock Text="精细" HorizontalAlignment="Center" /><TextBlock Text="5 秒" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                                            <RadioButton Style="{StaticResource IntervalChoice}" GroupName="Interval" IsChecked="{Binding IsTen, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="10"><StackPanel><TextBlock Text="细" HorizontalAlignment="Center" /><TextBlock Text="10 秒" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                                            <RadioButton Style="{StaticResource IntervalChoice}" GroupName="Interval" IsChecked="{Binding IsThirty, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="30"><StackPanel><TextBlock Text="一般" HorizontalAlignment="Center" /><TextBlock Text="30 秒 · 默认" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                                            <RadioButton Style="{StaticResource IntervalChoice}" GroupName="Interval" IsChecked="{Binding IsMinute, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="60"><StackPanel><TextBlock Text="省电" HorizontalAlignment="Center" /><TextBlock Text="1 分钟" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="通知" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Padding="7,5" Margin="0,0,0,16">
                                    <Expander Header="通知与昨日报告（可选）">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Margin="0,0,70,0">
                                                    <TextBlock Text="启动通知" FontSize="12.5" />
                                                    <TextBlock Text="下次启动时提示当前记录状态" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartNotificationEnabled, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="startup-notice" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="启动通知" />
                                            </Grid>
                                            <TextBlock Text="两项同时开启时合并发送，通知关闭不影响后台记录。" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,10,0,0" />
                                            <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,13" />
                                            <Grid>
                                                <StackPanel Margin="0,0,70,0">
                                                    <TextBlock Text="昨日用电报告" FontSize="12.5" />
                                                    <TextBlock Text="每天首次启动尝试发送，记录不足会明确提示" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding YesterdayReportEnabled, Mode=OneWay}" Command="{Binding ChangeCommand}" CommandParameter="yesterday-notice" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="昨日用电报告" />
                                            </Grid>
                                            <Expander Header="查看昨日报告与计价口径" Margin="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding YesterdayDetails}" TextWrapping="Wrap" Foreground="{StaticResource Ink2}" FontSize="11" LineHeight="21" />
                                                    <Button Content="刷新昨日报告" Command="{Binding LoadDetailsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <TextBlock Text="计费" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="TariffEditorHeading" Text="电价设置" FontSize="12.5" />
                                        <TextBlock Text="填好每度电的价格，就能开始算电费。其余选项保持默认即可。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding NeedsPriceSetup, Converter={StaticResource VisibleWhenTrue}}" />
                                        <TextBlock Text="使用人民币计费。1 度电 = 1 千瓦时，不计入整户固定月费。" Style="{StaticResource Caption}" Margin="0,5,0,14" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="电价（元/度）" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                                                <TextBox x:Name="PriceInputBox" Text="{Binding PriceInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="电价（元/度）" ToolTip="输入人民币每度电的单价，例如 0.6；不会预设地区电价" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="本地生效日期" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                                                <DatePicker SelectedDate="{Binding EffectiveDate}" SelectedDateFormat="Short" AutomationProperties.Name="电价生效日期" />
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="保存为新电价版本" Command="{Binding SaveTariffCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,7" />
                                        <TextBlock Text="{Binding TariffFeedback}" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                        <Expander Header="电价历史" Margin="0,10,0,0" IsExpanded="True">
                                            <ItemsControl ItemsSource="{Binding TariffHistory}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Background="{StaticResource ShellBg}" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" CornerRadius="7" Padding="11,7" Margin="0,0,0,5"><TextBlock Text="{Binding}" Foreground="{StaticResource Ink2}" FontSize="11" /></Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="外设功耗" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid><TextBlock x:Name="PeripheralEditorHeading" Text="将外设加入总功耗和总电费" FontSize="12.5" /><CheckBox IsChecked="{Binding PeripheralsEnabled, Mode=OneWay}" Command="{Binding TogglePeripheralsCommand}" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="启用外设估算" /></Grid>
                                        <TextBlock Text="仅填独立供电的显示器、音箱等；USB 键鼠已包含在主机中。" Style="{StaticResource Caption}" Margin="0,7,0,12" TextWrapping="Wrap" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="显示器使用功率（W）" Style="{StaticResource Caption}" Margin="0,0,0,7" /><TextBox Text="{Binding MonitorWattsInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="显示器使用功率" ToolTip="填写实际使用时的功率，不填写适配器最大额定瓦数；可留空" /></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="其他独立供电外设（W）" Style="{StaticResource Caption}" Margin="0,0,0,7" /><TextBox Text="{Binding PeripheralWattsInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="其他独立供电外设功率" ToolTip="合计使用功率；不要重复计入主机 USB 供电设备；可留空" /></StackPanel>
                                        </Grid>
                                        <Button Content="保存并启用" Command="{Binding SavePeripheralsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,7" />
                                        <TextBlock Text="{Binding PeripheralFeedback}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,0" />
                                        <TextBlock Text="按记录时段估算，外设关闭时请关闭此项；不会根据屏幕状态自动补算。" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="主机功耗来源" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16"><TextBlock Text="{Binding PowerSupplyStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" /></Border>
                                <TextBlock Text="数据备份" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="DataEditorHeading" Text="记录、电价和设置一起保存" FontSize="12.5" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="备份数据" Command="{Binding BackupDataCommand}" Padding="14,7" Margin="0,0,10,0" />
                                            <Button Content="恢复数据" Command="{Binding RestoreDataCommand}" Padding="14,7" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DataFeedback}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="关于 PC Watt" Style="{StaticResource H2}" />
                                        <TextBlock Text="开源 · 本地优先 · 无账号 · 不上传数据" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,8,0,6" />
                                        <TextBlock Text="硬件遥测由 LibreHardwareMonitor 提供。MIT 许可及第三方许可声明随程序提供。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        <TextBlock Text="自启动失败日志：用户数据目录 PCWatt\logs\startup.log 和 launcher.log" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource Ink2}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    <!-- ═══ 状态栏 ═══ -->
                    <Border Grid.Row="1" Background="{StaticResource ShellBg}" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="20,5">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Warn}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSampling}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding RecordingHint}" Foreground="{StaticResource Ink3}" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding SamplingCadence}" Foreground="{StaticResource Ink3}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
